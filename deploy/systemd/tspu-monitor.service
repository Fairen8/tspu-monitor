[Unit]
Description=TSPU Monitor 2 — диагностика блокировок DPI/TSPU
Documentation=https://github.com/Fairen8/tspu-monitor/blob/main/DOCS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tspu-monitor
Environment=TSPU_CONFIG_DIR=/opt/tspu-monitor/config
ExecStart=/opt/tspu-monitor/venv/bin/tspu-monitor daemon
Restart=on-failure
RestartSec=10

# Raw-пробы (scapy): TTL/IP-ID. Без них работают все остальные пробы.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Умеренная изоляция, не мешающая сетевым пробам.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
