# Нормализация переводов строк: в репозитории — LF.
* text=auto eol=lf

# Скрипты обязаны оставаться в LF (systemd/Docker/LXC).
*.sh text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Windows-скрипты, если появятся.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные артефакты.
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.gz binary
*.zip binary

# Сгенерированное и не подлежащее статистике.
dist/* linguist-generated=true
*.lock linguist-generated=true
